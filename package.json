{
  "name": "@kiwarilabs/stateful-precompiled-contracts",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "clean": "npx hardhat clean && rm -rf build cache coverage coverage.json dist",
    "compile": "npx hardhat compile",
    "coverage": "yarn compile && npx hardhat coverage",
    "build": "yarn clean && yarn compile && yarn test",
    "pack": "yarn run build && mkdir -p dist && cd contracts && yarn pack && mv *.tgz ../dist/",
    "size": "npx hardhat size-contracts",
    "test": "yarn compile && npx hardhat test",
    "format": "yarn prettier:sol && yarn prettier:ts",
    "prettier:sol": "prettier --write --plugin=prettier-plugin-solidity '**/*.sol'",
    "prettier:ts": "prettier --write '**/*.ts'"
  },
  "dependencies": {},
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.9",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@nomicfoundation/ignition-core": "^0.15.9",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.17",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=16.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.22.18",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^2.2.1",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.2",
    "solidity-coverage": "^0.8.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.1.0",
    "typescript": ">=5.5.4"
  },
  "copyright.owner": "Kiwari Labs"
}
